# Vendra Active Backend Adapter ("json", "postgres", "shopify", or "woocommerce")
# Note: Set to "postgres" for both a real PostgreSQL server and the local SQLite fallback.
# The adapter automatically infers the database dialect from the DATABASE_URL scheme.
ADAPTER=postgres

# Database Connection URL (Used when ADAPTER=postgres)
# - Default below: lightweight local-dev SQLite fallback, no Docker/Postgres server needed, works immediately after copying this file.
# - For a real production Postgres server, replace with: postgresql://username:password@host:5432/vendra
DATABASE_URL=sqlite:///data/vendra.db

# Groq API Configuration (REQUIRED)
# Generate your API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Redis Server Connection URL (Optional, falls back to in-memory if unset)
# Example: redis://localhost:6379/0
REDIS_URL=

# Stripe Test Mode Credentials (Optional, Mock checkout operates if unset)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Shopify API Integration (Used if ADAPTER=shopify)
SHOPIFY_URL=
SHOPIFY_API_KEY=

# WooCommerce API Integration (Used if ADAPTER=woocommerce)
WC_URL=
WC_KEY=
WC_SECRET=

# Secure Admin API Key (Required, generate a strong random value, e.g. openssl rand -hex 32)
ADMIN_API_KEY=

# JWT Secret Key for customer session authentication (Required, generate a strong random value, e.g. openssl rand -hex 32)
JWT_SECRET_KEY=

# LangSmith Observability Configuration (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=vendra

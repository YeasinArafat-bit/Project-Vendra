# Vendra Environment Variables Configuration
# Copy this file to .env and fill in the values

# Google Gemini API Key (Required for LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models Configuration for Fallback Resilience
PRIMARY_LLM_MODEL=gemini-2.5-flash
SECONDARY_LLM_MODEL=gemini-1.5-flash

# Stripe Keys for Test Mode (Required for Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# LangSmith Configuration (Optional for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=vendra-shopping-agent

# Database URL (Defaults to SQLite in the root folder)
DATABASE_URL=sqlite:///./vendra.db
